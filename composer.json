{
    "name": "genderapi/genderapi",
    "description": "Official GenderAPI.io V2 client for PHP",
    "type": "library",
    "license": "MIT",
    "keywords": ["genderapi", "gender", "gender-detection", "name", "email", "username", "api-client", "sdk"],
    "homepage": "https://www.genderapi.io/api-documentation",
    "support": {
        "docs": "https://www.genderapi.io/api-documentation",
        "issues": "https://github.com/GenderAPI/genderapi-php/issues",
        "source": "https://github.com/GenderAPI/genderapi-php"
    },
    "require": {
        "php": ">=8.1",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "suggest": {
        "ext-curl": "Used by the default transport; without it PHP streams are used",
        "ext-openssl": "Required for HTTPS when ext-curl is not available"
    },
    "autoload": {
        "psr-4": {
            "GenderApi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "GenderApi\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
